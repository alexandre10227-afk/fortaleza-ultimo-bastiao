extends SceneTree
const ARMORY = preload("res://scripts/city_armory_economy.gd")
const EQUIP = preload("res://scripts/equipment_catalog.gd")
const ECONOMY = preload("res://scripts/economy_system.gd")

func _initialize() -> void:
    call_deferred("run")

func run() -> void:
    assert(ARMORY.allowed_rarity(1) == "Comum")
    assert(ARMORY.allowed_rarity(2) == "Raro")
    assert(ARMORY.allowed_rarity(3) == "Raro")
    assert(ARMORY.allowed_rarity(4) == "Epico")
    assert(ARMORY.allowed_rarity(5) == "Epico")
    var levels := {"Ferraria":1}
    assert(ECONOMY.craft_cost("guerreiro_arma_comum_1",levels).size() > 0)
    assert(ECONOMY.craft_cost("guerreiro_arma_raro_1",levels).is_empty())
    levels["Ferraria"] = 2
    assert(not ECONOMY.craft_cost("guerreiro_arma_raro_1",levels).is_empty())
    assert(ECONOMY.craft_cost("guerreiro_arma_epico_1",levels).is_empty())
    levels["Ferraria"] = 4
    assert(not ECONOMY.craft_cost("guerreiro_arma_epico_1",levels).is_empty())
    assert(ECONOMY.craft_cost("guerreiro_arma_epico_3",levels).is_empty())
    levels["Ferraria"] = 5
    assert(not ECONOMY.craft_cost("guerreiro_arma_epico_3",levels).is_empty())
    assert(ECONOMY.craft_cost("guerreiro_arma_lendario_1",levels).is_empty())
    assert(ECONOMY.craft_cost("guerreiro_arma_mitico_1",levels).is_empty())
    assert(ECONOMY.craft_cost("espada_heroi",levels).is_empty())
    var econ := ARMORY.initial_state()
    assert(econ["troops"].size() == 24)
    var before_money := int(econ["treasury"])
    var result := ARMORY.settle_defense(econ,"onda_1",1,6)
    assert(result["requested"] == 96)
    assert(result["replacements"] > 0)
    assert(result["paid_to_forge"] > 0)
    assert(econ["forge_income"] == result["paid_to_forge"])
    assert(int(econ["treasury"]) < before_money)
    assert(int(econ["stock"]["ferro"]) < int(ARMORY.INITIAL_STOCK["ferro"]) + int(ARMORY.SUPPLY_DELIVERY["ferro"]))
    assert(ARMORY.settle_defense(econ,"onda_1",1,6).is_empty())
    var next_result := ARMORY.settle_defense(econ,"onda_2",4,11)
    assert(next_result["rarity"] == "Epico")
    assert(next_result["requested"] == 96)
    assert(next_result["replacements"] + next_result["repairs"] + next_result["unmet"] == next_result["requested"])
    var state = root.get_node("GameState")
    state.new_game("Economia","Normal")
    state.choose_oath(true)
    assert(state.city_armory["battle_orders"].is_empty())
    state.advance_days(5)
    assert(state.wave_number == 1)
    assert(state.city_armory["battle_orders"].size() == 1)
    var receipt: Dictionary = state.city_armory["battle_orders"][0]
    assert(int(receipt["paid_to_forge"]) > 0)
    assert(state.settle_city_defense("onda_1").is_empty())
    assert(state.save_game())
    state.new_game("Reset","Normal")
    assert(state.load_game())
    assert(state.city_armory["battle_orders"].size() == 1)
    assert(state.settle_city_defense("onda_1").is_empty())
    print("TEST_CITY_ARMORY_PASS")
    quit(0)
