extends SceneTree
const SIM = preload("res://scripts/simulation_foundations.gd")
func _initialize() -> void:
    call_deferred("run")
func run() -> void:
    var g = root.get_node("GameState")
    g.new_game("Guarda", "Normal")
    g.choose_oath(false)
    assert(g.military_intel["garrison"]["Fortaleza"]["commander"] == "general_vaelor")
    assert(SIM.add_report(g.military_intel, 1, "Fortaleza", "Rumor a investigar"))
    assert(g.military_intel["scouting_reports"][0]["verified"] == false)
    assert(g.register_apprenticeship("doran", "aprendiz_teste"))
    assert(not g.register_apprenticeship("outro", "aprendiz_teste"))
    assert(g.register_nemesis("inimigo_unico", "Sobreviveu a batalha"))
    assert(g.register_nemesis("inimigo_unico", "Retornou"))
    assert(g.nemesis_records["enemies"]["inimigo_unico"]["encounters"] == 2)
    assert(not SIM.register_migration(g.migration_history, "npc", "Fortaleza", "Fortaleza", 1))
    assert(SIM.register_migration(g.migration_history, "npc", "Fortaleza", "Porto Cinzento", 1))
    assert(g.save_game())
    g.new_game("Reset", "Facil")
    assert(g.load_game())
    assert(g.legacy_records["masters"]["aprendiz_teste"] == "doran")
    assert(g.nemesis_records["enemies"]["inimigo_unico"]["encounters"] == 2)
    assert(g.migration_history.size() == 1)
    assert(g.military_intel["scouting_reports"].size() == 1)
    print("TEST_SIMULATION_FOUNDATIONS_PASS")
    quit(0)
