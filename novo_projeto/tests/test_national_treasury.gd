extends SceneTree
const TERRITORY = preload("res://scripts/territory_economy.gd")
const ITEMS = preload("res://scripts/item_catalog.gd")

func _initialize() -> void:
    call_deferred("run")

func run() -> void:
    var led := TERRITORY.initial_state()
    assert(led["territories"].size() == 2)
    assert(TERRITORY.costs("Ferraria",1)["materials"]["pedra"] == 4)
    assert(TERRITORY.costs("Muralha",3)["materials"]["pedra_incomum"] == 2)
    assert(TERRITORY.costs("Ferraria",4)["materials"]["cristal_azul"] == 1)
    assert(TERRITORY.costs("Ferraria",5).is_empty())
    var fort: Dictionary = led["territories"]["Fortaleza"]
    var initial_fort := int(fort["treasury"])
    var initial_wood := int(fort["stock"]["madeira"])
    var labor := TERRITORY.settle_day(led,2)
    assert(labor.size() == 2)
    assert(int(fort["tax_received"]) > 0)
    assert(int(fort["goods_purchased"]["madeira"]) == 3)
    assert(int(fort["goods_purchased"]["pedra"]) == 2)
    assert(int(fort["stock"]["madeira"]) == initial_wood + 3)
    assert(int(fort["treasury"]) != initial_fort)
    assert(TERRITORY.settle_day(led,2).is_empty())
    assert(TERRITORY.can_build(led,"Fortaleza","Ferraria",1))
    var cost: Dictionary = TERRITORY.costs("Ferraria",1)
    var money_before := int(fort["treasury"])
    var wood_before := int(fort["stock"]["madeira"])
    assert(TERRITORY.build(led,"Fortaleza","Ferraria",1))
    assert(int(fort["treasury"]) == money_before - int(cost["gold"]))
    assert(int(fort["stock"]["madeira"]) == wood_before - int(cost["materials"]["madeira"]))
    assert(not TERRITORY.build(led,"Fortaleza","Ferraria",5))
    var bag := {"maca":3,"ferro":1}
    var equipment := {"weapon":"ferro"}
    assert(not TERRITORY.can_list("ferro",ITEMS.get_item("ferro"),1,bag,equipment))
    assert(TERRITORY.list_item(led,"maca",ITEMS.get_item("maca"),2,"Fortaleza",2,bag,equipment))
    assert(bag["maca"] == 1)
    assert(TERRITORY.settle_sales(led,2).is_empty())
    var liquidity_before := int(fort["market_liquidity"])
    var tax_before := int(fort["consign_tax"])
    var sale := TERRITORY.settle_sales(led,3)
    assert(sale.size() == 1)
    assert(int(sale[0]["player"]) + int(sale[0]["tax"]) == int(sale[0]["gross"]))
    assert(int(fort["market_liquidity"]) == liquidity_before-int(sale[0]["gross"]))
    assert(int(fort["consign_tax"]) == tax_before+int(sale[0]["tax"]))
    assert(led["consignments"][0]["quantity"] == 1)
    assert(TERRITORY.withdraw_listing(led,1,bag))
    assert(bag["maca"] == 2)
    assert(not TERRITORY.withdraw_listing(led,1,bag))
    var port: Dictionary = led["territories"]["Porto Cinzento"]
    var buyer_money := int(port["treasury"])
    var seller_money := int(fort["treasury"])
    assert(TERRITORY.trade_for_alliance(led,"Fortaleza","Fortaleza","madeira",1).is_empty())
    var deal := TERRITORY.trade_for_alliance(led,"Fortaleza","Porto Cinzento","madeira",3)
    assert(deal["gold"] == 24)
    assert(int(port["treasury"]) == buyer_money-24)
    assert(int(fort["treasury"]) == seller_money+24)
    assert(deal["relation"] == 15)
    for i in range(3):
        deal = TERRITORY.trade_for_alliance(led,"Fortaleza","Porto Cinzento","madeira",3)
    assert(deal["alliance"])
    assert(fort["alliances"].has("Porto Cinzento"))
    var state = root.get_node("GameState")
    state.new_game("Tesouro","Normal")
    state.choose_oath(true)
    state.inventory["maca"] = 2
    assert(state.consign_player_item("maca",2))
    assert(not state.consign_player_item("maca",1))
    var balance := state.money
    state.advance_days(1)
    assert(state.money > balance)
    assert(state.national_treasury("Fortaleza")["consign_tax"] > 0)
    var before_upgrade := int(state.building_levels["Ferraria"])
    assert(state.upgrade_public_building("Ferraria"))
    assert(int(state.building_levels["Ferraria"]) == before_upgrade+1)
    assert(state.save_game())
    state.new_game("Reset","Facil")
    assert(state.load_game())
    assert(state.national_treasury("Fortaleza")["consign_tax"] > 0)
    assert(int(state.building_levels["Ferraria"]) == before_upgrade+1)
    assert(state.national_economy["consignments"].size() == 1)
    print("TEST_NATIONAL_TREASURY_PASS")
    quit(0)
