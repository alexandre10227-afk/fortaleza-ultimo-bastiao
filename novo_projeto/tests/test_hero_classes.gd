extends SceneTree
const HERO = preload("res://scripts/hero_classes.gd")
func _initialize() -> void:
    call_deferred("run")
func run() -> void:
    assert(HERO.STARTERS.size() == 6)
    for archetype_name in HERO.STARTERS:
        assert(HERO.valid(HERO.starter(archetype_name)))
    assert(HERO.make("Guerreiro","Espada e Escudo",[],"Epico") != {})
    assert(HERO.make("Guerreiro","Espada e Escudo",[],"Mitico") == {})
    assert(HERO.make("Guerreiro","Samurai",[],"Epico") != {})
    assert(HERO.make("Guerreiro","Mestre Espadachim",[],"Lendario") != {})
    assert(HERO.make("Mago","Mago do Trovao",["Trovao"],"Epico") != {})
    assert(HERO.make("Mago","Mago Verde",["Verde"],"Epico") != {})
    assert(HERO.make("Mago","Mago Verde",["Verde"],"Lendario") == {})
    var mage := HERO.starter("Mago")
    mage = HERO.learn_element(mage,"Agua")
    assert(mage["rarity"] == "Epico")
    mage = HERO.learn_element(mage,"Fogo")
    assert(mage["rarity"] == "Lendario")
    var elementalist := HERO.become_elementalist(mage)
    assert(elementalist["rarity"] == "Lendario")
    assert(elementalist["elements"].size() == 4)
    elementalist = HERO.evolve(elementalist,"Mitico")
    assert(elementalist["rarity"] == "Mitico")
    assert(HERO.evolve(elementalist,"Mitico") == {})
    assert(HERO.make("Mago","Mago Elemental",["Agua","Agua"]) == {})
    print("TEST_HERO_CLASSES_PASS")
    quit(0)
