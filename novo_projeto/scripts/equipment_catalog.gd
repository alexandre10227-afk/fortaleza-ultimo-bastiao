const MERCHANT_ARCHETYPES := {"doran":"Guerreiro","mercador_marcial":"Cavaleiro","mercador_arcano":"Mago","mercador_sagrado":"Sacerdote"}
const REWARDS := {"boss":{"rei_lobos":"machado_rei_lobos","carrasco_ferro":"escudo_carrasco","feiticeira_lua":"cetro_lua_partida","guardiao_raizes":"reliquia_arvore_antiga"},"dungeon":{"cripta_abismo":"capuz_abismo","sala_corrente":"botas_rio_sombrio","sala_guardiao":"peitoral_ancora","sala_aurora":"manto_primeira_luz"},"quest":{"missao_espada_heroi":"espada_heroi","evento_duque":"armadura_duque","juramento_do_ferreiro":"lamina_promessa","prova_do_exilio":"escudo_exilado","ecos_do_passado":"orbe_memorias","votos_da_aurora":"cetro_misericordia"}}

static func is_equipment(id: String) -> bool:
    return GEAR.has(id)

static func is_special(id: String) -> bool:
    return GEAR.has(id) and bool(GEAR[id].get("unique",false))

static func can_equip(id: String, hero_class: String) -> bool:
    return GEAR.has(id) and (str(GEAR[id]["class"]) == hero_class or str(GEAR[id]["class"]) == "Todas")

static func slot_for(id: String) -> String:
    return str(GEAR[id]["slot"]) if GEAR.has(id) else ""

static func vendor_inventory(npc_id: String) -> Array[String]:
    var answer: Array[String] = []
    var archetype := str(MERCHANT_ARCHETYPES.get(npc_id, ""))
    for id in GEAR:
        var item: Dictionary = GEAR[id]
        if item["class"] == archetype and str(item.get("source","")) == "merchant" and item["rarity"] in ["Raro","Epico"]:
            answer.append(str(id))
    answer.sort()
    return answer

static func common_forge_inventory(hero_class: String) -> Array[String]:
    var result: Array[String] = []
    for id in GEAR:
        var item: Dictionary = GEAR[id]
        if item["class"] == hero_class and item.get("source","") == "forge" and FORGE_RECIPES.has(id):
            result.append(str(id))
    result.sort()
    return result

static func equipment_for(hero_class: String, slot: String = "", rarity: String = "") -> Array[String]:
    var result: Array[String] = []
    for id in GEAR:
        var item: Dictionary = GEAR[id]
        if (item["class"] == hero_class or item["class"] == "Todas") and (slot.is_empty() or item["slot"] == slot) and (rarity.is_empty() or item["rarity"] == rarity):
            result.append(str(id))
    result.sort()
    return result

static func reward_for(source: String, event_id: String) -> String:
    var source_items: Dictionary = REWARDS.get(source,{})
    return str(source_items.get(event_id,""))

static func equip_slots() -> Dictionary:
    return {"weapon":"","head":"","chest":"","feet":""}

static func totals(equipped: Dictionary) -> Dictionary:
    var result := {"attack":0,"defense":0,"life":0,"mana":0,"agility":0,"healing":0,"critical":0}
    for slot in SLOTS:
        var id := str(equipped.get(slot,""))
        if GEAR.has(id) and str(GEAR[id]["slot"]) == slot:
            var bonuses: Dictionary = GEAR[id].get("stats",{})
            for stat in result:
                result[stat] += int(bonuses.get(stat,0))
    return result

static func validate_catalog() -> bool:
    for id in GEAR:
        var item: Dictionary = GEAR[id]
        if not CLASS_ORDER.has(item["class"]) and item["class"] != "Todas":
            return false
        if not SLOTS.has(item["slot"]) or not RARITIES.has(item["rarity"]):
            return false
        if item.get("source","") == "forge" and not FORGE_RECIPES.has(id):
            return false
        if is_special(str(id)) and item.get("source","") == "merchant":
            return false
    for kind in REWARDS:
        for event_id in REWARDS[kind]:
            if not is_special(str(REWARDS[kind][event_id])):
                return false
    return true
